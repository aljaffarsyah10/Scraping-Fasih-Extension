{
  "manifest_version": 3,
  "name": "Fasih Assignment Raw Exporter",
  "version": "1.0.2",
  "description": "Ekspor daftar assignment & raw data ringkas dari Fasih SM BPS ke Excel (.xlsx) dan CSV dengan 1 klik.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://fasih-sm.bps.go.id/app/*"
      ],
      "js": [
        "injected-hook.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://fasih-sm.bps.go.id/app/*"
      ],
      "js": [
        "exporter.js",
        "scraperEngine.js",
        "uiManager.js",
        "content.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://fasih-sm.bps.go.id/*"
  ]
}
